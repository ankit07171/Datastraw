# ---- backend ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roster?retryWrites=true&w=majority
PORT=4000
# comma-separated list of allowed frontend origins (only needed when frontend and API are on different hosts)
CLIENT_ORIGIN=http://localhost:5173
# set to false to stop auto-loading sample data into an empty database
AUTO_SEED=true

# ---- frontend (Vite) ----
# leave empty in dev (Vite proxies /api to the backend); set to the deployed API URL in production
VITE_API_URL=
